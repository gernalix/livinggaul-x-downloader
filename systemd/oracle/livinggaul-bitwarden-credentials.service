[Unit]
Description=Prepare selected LivingGaul credentials from Bitwarden
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/bws-files --ref ORACLE_TELEGRAM_ENV --encoding utf8 --file token=TELEGRAM_BOT_TOKEN --file chat=NOISY_TELEGRAM_CHAT_ID
UMask=0077
LimitCORE=0
TimeoutStartSec=100
